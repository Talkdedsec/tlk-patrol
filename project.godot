; Engine configuration file.
config_version=5

[application]

config/name="Blue Line Patrol"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
GameState="*res://scripts/autoload/game_state.gd"
Dispatch="*res://scripts/autoload/dispatch.gd"
World="*res://scripts/world/world.gd"
Vehicles="*res://scripts/vehicles/vehicles.gd"
Weapons="*res://scripts/weapons/weapons.gd"
Els="*res://scripts/els/els.gd"
Sirens="*res://scripts/audio/sirens.gd"
Pursuit="*res://scripts/pursuit/pursuit.gd"
TrafficStop="*res://scripts/traffic_stop/traffic_stop.gd"
Mdt="*res://scripts/mdt/mdt.gd"
Calls="*res://scripts/calls/calls.gd"
Traffic="*res://scripts/traffic/traffic.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
